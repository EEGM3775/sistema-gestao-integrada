# ============================================================
# VPS (teste real em https://www.gmaxis.com) — modo produção, sem drone.
#
# NÃO preencha à mão: `bash infra/vps/gerar-env.sh` cria `deploy/env/vps.env`
# (gitignored) a partir deste arquivo, com todos os `TROQUE-*` trocados por segredos
# fortes — só o CLOUDFLARE_TUNNEL_TOKEN você informa. Suba com `bash infra/vps/up.sh`
# (passo a passo em infra/vps/README.md).
#
# Igual ao staging: DEBUG=False / IAM_DEBUG=False → RS256 obrigatório, cookies `Secure`
# (`__Host-`) + HSTS, fail-fast de config. O TLS termina no Cloudflare (túnel).
# ============================================================

# --- Identidade do stack ---
COMPOSE_PROJECT_NAME=sgi-vps
SGI_PREFIX=sgi-vps

# Portas de host — todas presas em 127.0.0.1 pelo deploy/compose/vps.yml (nada público).
GATEWAY_PORT=8090            # só no loopback do servidor; a internet entra pelo túnel
DB_PORT=5432
REDIS_PORT=6379

# --- Segredo JWT compartilhado ---
# Em produção/staging (DEBUG=False) a assinatura é RS256 (chaves abaixo); este
# segredo HS256 NÃO assina tokens de usuário. Ainda é lido pelo java-service do
# drone — mantenha forte. Gere as chaves RSA com `bash infra/keys/generate.sh`.
JWT_SECRET=TROQUE-jwt-secret-forte
JWT_ACCESS_MINUTES=5
# Sessão SEM "manter conectado": janela DESLIZANTE de inatividade + teto absoluto.
# (JWT_REFRESH_DAYS foi removido: o SimpleJWT o lia e a IAM SOBRESCREVIA logo em
#  seguida com os valores abaixo — ou seja, aquele knob nunca valeu nada.)
JWT_SESSION_IDLE_HOURS=2
JWT_SESSION_IDLE_CAP_HOURS=12
# Sessão COM "manter conectado" (equipamento pessoal): desliza 7d, teto absoluto 30d.
# O teto limita por quanto tempo uma sessão roubada pode ser mantida viva por rotação.
JWT_SESSION_REMEMBER_DAYS=7
JWT_SESSION_CAP_DAYS=30
# Aviso de queda (modal com contagem) N minutos antes de a sessão expirar.
JWT_SESSION_WARN_MINUTES=15

# --- PostgreSQL (cluster próprio do staging, volume separado) ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=TROQUE-superuser-postgres-forte
DB_HOST=localhost
DB_SSLMODE=disable

POSTGRES_DB=erp_db
POSTGRES_USER=erp_app
POSTGRES_PASSWORD=TROQUE-senha-erp_app-forte

IAM_POSTGRES_DB=iam_db
IAM_POSTGRES_USER=iam_app
IAM_POSTGRES_PASSWORD=TROQUE-senha-iam_app-forte

# --- Redis (cache + Celery + revogação de sessão DB 2) ---
REDIS_URL=redis://redis:6379/0
SESSION_REVOKE_REDIS_URL=redis://redis:6379/2
AUTORIZACAO_REDIS_URL=redis://redis:6379/5

# --- PDP (SpiceDB) — remodelagem, fases 2 e 3 ---
SPICEDB_URL=http://spicedb:8443
SPICEDB_CHAVE=TROQUE-chave-longa-do-spicedb
SPICEDB_DB_PASSWORD=TROQUE-senha-spicedb_app-forte
AUTORIZACAO_SOMBRA=True

# --- Django (backend) — PRODUÇÃO ---
DEBUG=False
SECRET_KEY=TROQUE-secret-key-do-django-forte
# Host header chega como www.gmaxis.com (pelo túnel) + nomes
# internos dos containers usados nos healthchecks/rede.
ALLOWED_HOSTS=www.gmaxis.com,localhost,127.0.0.1,erp,gateway
# Com worker+beat reais na stack, as tasks vão para o broker (não in-process).
CELERY_TASK_ALWAYS_EAGER=False

# --- IAM — PRODUÇÃO ---
IAM_DEBUG=False
IAM_SECRET_KEY=TROQUE-secret-key-do-iam-forte
# Chave Fernet do segundo fator: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
IAM_SEGUNDO_FATOR_CHAVE=TROQUE-chave-fernet-do-segundo-fator
IAM_ALLOWED_HOSTS=www.gmaxis.com,localhost,127.0.0.1,iam,gateway

# --- Integrações / segredos de serviço ---
# Asaas: staging usa a SANDBOX (nunca a conta de produção). Preencha sob demanda.
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# NFE.io — deixe vazio até validar emissão de NF (validação sob demanda).
NFE_IO_BASE_URL=https://api.nfe.io/v1
NFE_IO_API_KEY=
NFE_IO_COMPANY_ID=
# Segredo backend→IA (obrigatório fora de DEBUG, sem fallback público — S7).
IA_SERVICE_SECRET_TOKEN=TROQUE-segredo-do-servico-de-ia-forte
# LLM de visão local (Fase 11.3). Vazio = análise de imagem fica em `erro` (não trava o diário).
LLM_VISION_URL=

# --- Serviço→serviço com o drone (Fase 10.8) ---
SERVICE_TOKEN_SECRET=TROQUE-segredo-servico-a-servico-forte
IAM_INTERNAL_URL=http://iam:8001
# Origens permitidas do drone (CORS + handshake WebSocket). PRECISA conter a
# origem do gateway de staging (HTTPS) — senão o browser é barrado antes do /ws.
APP_CORS_ALLOWED_ORIGINS=https://www.gmaxis.com

# --- Canal WhatsApp (multi-tenant via banco; andaime de dev desligado) ---
WHATSAPP_DEFAULT_TENANT_SLUG=
WHATSAPP_DEFAULT_PHONE_NUMBER_ID=
WHATSAPP_DEFAULT_ACCESS_TOKEN=
WHATSAPP_DEFAULT_APP_SECRET=
WHATSAPP_DEFAULT_VERIFY_TOKEN=

# --- E-mail (notificações do CRM · recuperação de senha D11) ---
# ATENÇÃO: aqui `IAM_DEBUG=False`, e nesse modo a IAM **exige** MAIL_HOST — sem
# ele, a recuperação de senha aceitaria o pedido e nunca entregaria o token,
# travando o usuário em silêncio (por isso o settings recusa subir). Apontamos
# para o Mailpit do staging, que captura tudo e não entrega a ninguém.
# Antes do go-live isto vira um SMTP real (ver 10.3.2 — aposentar os andaimes).
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Sistema de Gestão <noreply@sistemagestao.com>
# Portas de host próprias, para não colidir com o Mailpit do dev (8025/1025).
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# --- Recuperação de senha (D11) ---
# Base pública dos links do e-mail: precisa ser o gateway TLS do staging, senão
# o link apontaria para o dev (localhost:8090) e o usuário cairia no ambiente errado.
FRONTEND_BASE_URL=https://www.gmaxis.com
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_COOLDOWN_TROCA_EMAIL_HORAS=24

# --- Maps: provedores geo (docs/modulos/modulomaps.md §9) -------------------
# Vazio = sem geocodificador (pin cai no centro da cidade) e rota em linha reta.
# Os servidores públicos do OSM servem para testar, com limite de uso e sem garantia:
#   NOMINATIM_URL=https://nominatim.openstreetmap.org   OSRM_URL=https://router.project-osrm.org
# Para uso contínuo: Nominatim self-host, ou LocationIQ (NOMINATIM_URL=https://us1.locationiq.com/v1
# + NOMINATIM_API_KEY), e OSRM self-host (perfil car).
NOMINATIM_URL=
NOMINATIM_API_KEY=
NOMINATIM_USER_AGENT=sgi-plataforma/1.0
OSRM_URL=
TITILER_URL=

# --- VPS (gmaxis.com) -------------------------------------------------------
# Token do túnel: painel Cloudflare → Zero Trust → Networks → Tunnels → (o túnel) → token.
# Hostname público do túnel: www.gmaxis.com → HTTP → gateway:80
CLOUDFLARE_TUNNEL_TOKEN=TROQUE-token-do-tunel-cloudflare
