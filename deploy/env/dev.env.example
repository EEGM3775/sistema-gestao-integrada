# ============================================================
# DESENVOLVIMENTO — variáveis de ambiente do SGI
#
#   cp deploy/env/dev.env.example .env      (na RAIZ do repositório)
#
# O arquivo real fica na RAIZ, não aqui: é de lá que o `docker compose` o carrega
# sozinho e que o `load_dotenv()` do backend e da IAM o encontram ao rodar fora do
# Docker. Nesta pasta ficam só os EXEMPLOS, um por ambiente:
#
#   dev.env.example      -> este (máquina do desenvolvedor)
#   staging.env.example  -> deploy/env/staging.env  (modo produção, validado)
#   prod.env.example     -> produção  (NÃO VALIDADO — ver deploy/README.md)
#
# NUNCA versione o .env real. Ver docs/arquitetura.md (Fase 0) para o contexto.
# ============================================================

# --- Compose: quais arquivos valem por padrão --------------------------------
# Com isto os comandos de sempre continuam funcionando da RAIZ do repositório
# (`docker compose --profile full up -d`), mesmo com os arquivos em deploy/compose/.
# Sem isto seria preciso repetir `-f deploy/compose/base.yml -f deploy/compose/dev.yml`
# em todo comando. Para staging use os helpers em infra/staging/.
# O separador padrão é ";" no Windows e ":" no Linux — fixamos ":" para o mesmo
# .env valer nos dois (o projeto roda no Docker Desktop/Windows e no WSL).
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=deploy/compose/base.yml:deploy/compose/dev.yml

# --- Segredo JWT compartilhado (SSO) — SÓ DEV ---
# Usado apenas no modo de desenvolvimento (DEBUG=True), quando a assinatura cai
# para HS256. Em PRODUÇÃO (DEBUG=False) a assinatura HS256 é PROIBIDA (S3): defina
# as chaves RSA abaixo — a IAM assina com a privada e os validadores só conferem
# com a pública, sem poder forjar. Gere o par com `bash infra/keys/generate.sh`.
JWT_SECRET=troque-este-segredo-compartilhado-por-um-forte
# Caminhos das chaves RSA (RS256). Obrigatórios em produção; o compose já os aponta
# para /keys/*.pem nos containers. Localmente, aponte para infra/keys/ se for testar RS256.
# JWT_PRIVATE_KEY_PATH=infra/keys/jwt_private.pem   # só a IAM
# JWT_PUBLIC_KEY_PATH=infra/keys/jwt_public.pem     # IAM + backend + drone

# --- PostgreSQL (cluster de dev via docker-compose) ---
# Superusuário de bootstrap usado só pelo container do Postgres.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
# TLS na conexão com o banco. Em dev, `disable` (o Postgres do compose não tem
# cert). Em produção use `verify-full` com Postgres gerenciado — era o achado D14:
# o compose CRAVAVA `disable` e este knob não valia nada.
DB_SSLMODE=prefer
# CA usada para verificar o certificado do servidor. Obrigatória com verify-full;
# sem ela o modo falha na verificação (e não cai em conexão insegura silenciosa).
DB_SSLROOTCERT=
# Reuso de conexão (s). 0 = abre/fecha por request.
DB_CONN_MAX_AGE=60

# Banco e role da aplicação backend (Django)
POSTGRES_DB=erp_db
POSTGRES_USER=erp_app
POSTGRES_PASSWORD=erp_app_senha_dev

# Banco e role da aplicação IAM
IAM_POSTGRES_DB=iam_db
IAM_POSTGRES_USER=iam_app
IAM_POSTGRES_PASSWORD=iam_app_senha_dev

# --- Redis (cache + Celery) ---
# Um Redis, DBs separados por função: 0=broker/result Celery, 1=cache do backend,
# 2=épocas de revogação de sessão (compartilhado IAM+backend+drone), 3=cache da IAM
# (contagem do throttle). Separar evita que um `FLUSHDB` de cache apague revogação.
REDIS_URL=redis://localhost:6379/0
SESSION_REVOKE_REDIS_URL=redis://localhost:6379/2
IAM_CACHE_REDIS_URL=redis://localhost:6379/3
# DB 4 = baldes de token da CAMADA 2 (limite de saída por fornecedor).
RATE_LIMIT_REDIS_URL=redis://localhost:6379/4
# DB 5 = autorização: versões, ZedToken e cache de decisão do PDP (fases 2 e 3).
AUTORIZACAO_REDIS_URL=redis://localhost:6379/5

# --- PDP (SpiceDB) — remodelagem da segurança, fases 2 e 3 ---
# A IAM grava as relações; o backend confere cada decisão (a sombra) e, módulo a
# módulo, deixa o PDP decidir (`manage.py modo_autorizacao`).
SPICEDB_URL=http://spicedb:8443
SPICEDB_CHAVE=spicedb-chave-dev
SPICEDB_DB=spicedb_db
SPICEDB_DB_USER=spicedb_app
SPICEDB_DB_PASSWORD=spicedb_app_senha_dev
AUTORIZACAO_SOMBRA=True

# --- Camada 2: limite de saída por fornecedor (docs/arquitetura/rate-limiting.md)
# Protege a cota do TERCEIRO — e, em cobrança/NF, dinheiro e documento fiscal.
# Nenhum limite de ENTRADA faz isso: a view enfileira, quem chama o fornecedor é o
# worker, o endpoint de lote emite N notas numa requisição só e o retry multiplica.
#
# Por fornecedor: RATE_LIMIT_<NOME>_TAXA (tokens/segundo, ritmo sustentado) e
# RATE_LIMIT_<NOME>_BURST (tamanho do balde = maior lote que passa de uma vez).
# A TAXA sai do CONTRATO com o fornecedor (use uma fração do limite publicado);
# o BURST sai do MAIOR LOTE legítimo — se o fechamento emite 200 notas de uma vez,
# balde menor que isso transforma operação normal em fila.
# Sinais de má calibração: DLQ com falhas de limite (apertado) ou 429 vindo do
# próprio fornecedor (folgado). Fornecedor sem config passa SEM limite.
# RATE_LIMIT_NFE_IO_TAXA=2
# RATE_LIMIT_NFE_IO_BURST=200
# RATE_LIMIT_ASAAS_TAXA=5
# RATE_LIMIT_ASAAS_BURST=100
# RATE_LIMIT_WHATSAPP_TAXA=10
# RATE_LIMIT_LLM_VISION_TAXA=1
# RATE_LIMIT_EMAIL_TAXA=10
# Desliga a camada 2 inteira (diagnóstico). Deixa TODA chamada a fornecedor sem teto.
RATE_LIMIT_DESLIGADO=False
# CELERY_TASK_ALWAYS_EAGER=True roda a task NO PRÓPRIO REQUEST (sem worker).
# DEIXE COMENTADO no dev: o default do código é `True` quando DEBUG=True, que é o
# que permite trabalhar sem subir worker. Definir `False` aqui, sem worker rodando,
# faz as tasks enfileirarem para sempre e a cobrança/NF simplesmente não acontecer.
# Nos containers o valor é definido por serviço no compose (lá o worker existe).
# CELERY_TASK_ALWAYS_EAGER=False

# --- Django (backend) ---
# DEBUG default do código = False (produção). Mantenha True SÓ em dev. Em produção
# (DEBUG=False) SECRET_KEY e ALLOWED_HOSTS são OBRIGATÓRIOS: sem eles o serviço se
# recusa a subir (S4), em vez de usar segredos conhecidos e expor stack traces.
SECRET_KEY=troque-esta-secret-key-do-django
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- IAM ---
# Mesma regra: IAM_DEBUG default = False; em produção IAM_SECRET_KEY e
# IAM_ALLOWED_HOSTS são obrigatórios (fail-fast).
IAM_SECRET_KEY=troque-esta-secret-key-do-iam
# Vazio em dev: a IAM deriva a cifra do segundo fator do IAM_SECRET_KEY.
IAM_SEGUNDO_FATOR_CHAVE=
IAM_DEBUG=True
IAM_ALLOWED_HOSTS=localhost,127.0.0.1,iam,gateway
# Access curto (5 min): fecha a janela de acesso residual do access stateless
# (Fase 10.7); o refresh silencioso renova sem o usuário perceber.
JWT_ACCESS_MINUTES=5
# Sessão SEM "manter conectado": janela DESLIZANTE de inatividade + teto absoluto.
# A rotação só ocorre com interação real do usuário (o front para de renovar quando
# ocioso), senão a aba aberta seguraria a sessão para sempre.
# (JWT_REFRESH_DAYS foi removido: o SimpleJWT o lia e a IAM SOBRESCREVIA logo em
#  seguida com os valores abaixo — aquele knob nunca valeu nada.)
JWT_SESSION_IDLE_HOURS=2
JWT_SESSION_IDLE_CAP_HOURS=12
# Sessão COM "manter conectado" (equipamento pessoal): desliza 7d, teto absoluto 30d.
# O teto limita por quanto tempo uma sessão roubada pode ser mantida viva por rotação.
JWT_SESSION_REMEMBER_DAYS=7
JWT_SESSION_CAP_DAYS=30
# Aviso de queda (modal com contagem) N minutos antes de a sessão expirar.
JWT_SESSION_WARN_MINUTES=15

# --- Cookie do refresh e revogação de sessão (antes indocumentados — D15) ---
# IAM_COOKIE_SECURE: default = LIGADO fora de DEBUG. Só coloque 0 em dev sem HTTPS;
# desligar em produção faz a sessão trafegar em HTTP puro.
IAM_COOKIE_SECURE=0
IAM_COOKIE_SAMESITE=Strict
IAM_REFRESH_COOKIE=sgi_refresh
# Revogação imediata (época no Redis). ENABLED=False DESLIGA o controle inteiro:
# trocar/resetar senha e desativar usuário deixam de cortar o access residual.
SESSION_REVOCATION_ENABLED=True
# FAIL_OPEN=True: se o Redis cair, autentica normalmente (disponibilidade sobre
# revogação). False = fail-closed: Redis fora derruba TODA autenticação.
SESSION_REVOCATION_FAIL_OPEN=True
# TTL do JWT de serviço (backend→drone). Curto de propósito.
SERVICE_TOKEN_TTL_SECONDS=120
# Emissor e público do JWT (claims `iss`/`aud`) — S8. A IAM assina com estes
# valores e o backend os EXIGE; divergência entre os dois serviços derruba TODA a
# autenticação, então mude-os sempre no mesmo deploy dos dois lados.
# Emissor e audiência saíram do env na fase 5 da remodelagem: a audiência é POR
# SERVIÇO (sgi-api, sgi-drone, sgi-iam) e mora em funcoesautorizacao/audiencias.py.
# Volta atrás da fase 5 (só em incidente, as duas juntas):
# BFF_ACCESS_NO_CORPO=False
# BFF_BEARER_DO_CLIENTE=False
# Capacidade (a IAM é consultada a cada chamada à API desde a fase 5):
# IAM_GUNICORN_WORKERS=2
# IAM_GUNICORN_THREADS=8
# ERP_GUNICORN_WORKERS=2
# ERP_GUNICORN_THREADS=4
# Chaves RS256 (S3): fora de DEBUG são OBRIGATÓRIAS. Geradas por infra/keys/generate.sh
# e montadas em /keys pelo compose.
JWT_PRIVATE_KEY_PATH=/keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/keys/jwt_public.pem
# Cabeçalhos de segurança (aplicados fora de DEBUG). SSL_REDIRECT fica desligado
# porque o TLS termina no gateway — ligá-lo no app causaria loop de redirect.
SECURE_HSTS_SECONDS=31536000
SECURE_SSL_REDIRECT=False

# --- funcoesODM (banco próprio, separado do cluster backend/IAM) ---
ODM_POSTGRES_DB=funcoesodm
ODM_POSTGRES_USER=funcoesodm
ODM_POSTGRES_PASSWORD=funcoesodm_dev

# --- Gateway (Fase 4, compose unificado) ---
GATEWAY_PORT=8090

# --- Integrações / segredos de serviço ---
# ASAAS_WEBHOOK_TOKEN: conferido (tempo constante) no header `asaas-access-token`
# do webhook de cobranças. Vazio = nenhum webhook é aceito (fail-closed).
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# NFE.io — emissão/consulta de NFS-e (Fase 11.1: o Node `funcoesnf` + bridge PHP
# foi absorvido por uma Celery task Python que fala REST direto com a NFE.io).
# Credencial GLOBAL nesta fase (uma conta p/ todos os tenants, como o Asaas).
# Vazio = emissão fica em `ERRO`/retry (não trava o título).
NFE_IO_API_KEY=
NFE_IO_COMPANY_ID=

# --- Maps: provedores geo (docs/modulos/modulomaps.md §9) -------------------
# Sem eles o mapa funciona, mas degrada declarando: pin cai no centro da cidade
# (sem geocodificador de endereço) e a rota é a reta entre paradas (sem motor).
# Em DEV apontamos para os servidores PÚBLICOS do OpenStreetMap — servem para
# testar, não para produção: o Nominatim público aceita ~1 consulta/s e proíbe
# uso pesado; o OSRM público é demonstração, sem garantia. Em produção, use
# self-host ou um provedor com chave (ver prod.env.example).
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Chave do provedor compatível com Nominatim (LocationIQ: NOMINATIM_URL=https://us1.locationiq.com/v1).
# Vai como `?key=` — vazio para o Nominatim público ou self-host.
NOMINATIM_API_KEY=
# Exigência da política do Nominatim público: identifique a instalação (com contato).
NOMINATIM_USER_AGENT=sgi-plataforma-dev/1.0
OSRM_URL=https://router.project-osrm.org
# Servidor de tiles (TiTiler) das ortofotos do acervo. Vazio = acervo sem imagem.
TITILER_URL=
# IA_SERVICE_SECRET_TOKEN: segredo do worker de IA. Em produção (DEBUG=False) é
# OBRIGATÓRIO — sem fallback público (S7). Usado como token serviço→serviço na
# chamada à LLM de visão local.
IA_SERVICE_SECRET_TOKEN=troque-este-segredo-do-servico-de-ia
# LLM_VISION_URL: serviço Python local de visão (Fase 11.3). Recebe imagem+tipo
# e devolve o JSON de análise. Vazio = análise fica em `erro` (não trava o diário).
LLM_VISION_URL=

# --- Canal WhatsApp (Fase 11.3 / Fase C) ---
# Produção é MULTI-TENANT: cada tenant tem seu número/credenciais Meta no modelo
# funcoeswhatsapp.CanalWhatsApp (admin). As variáveis abaixo são um ANDAIME DE DEV
# single-tenant (só valem com DEBUG=True e sem CanalWhatsApp no banco): o webhook
# resolve o tenant pelo slug e usa estas credenciais. Deixe vazias em produção.
WHATSAPP_DEFAULT_TENANT_SLUG=
WHATSAPP_DEFAULT_PHONE_NUMBER_ID=
WHATSAPP_DEFAULT_ACCESS_TOKEN=
WHATSAPP_DEFAULT_APP_SECRET=
WHATSAPP_DEFAULT_VERIFY_TOKEN=

# --- Serviço→serviço com o drone (Fase 10.8) ---
# SERVICE_TOKEN_SECRET: segredo compartilhado entre backend e IAM para o endpoint
# /auth/service-token/ (JWT de serviço de vida curta). OBRIGATÓRIO fora de DEBUG
# (fail-fast, sem fallback público). Ao excluir obra/empreendimento o backend
# pede um token à IAM com este segredo e desvincula os projetos de drone órfãos.
SERVICE_TOKEN_SECRET=troque-este-segredo-servico-a-servico
# URLs internas (rede do compose). DRONE_SERVICE_URL vazio = reconciliação no-op.
IAM_INTERNAL_URL=http://iam:8001
DRONE_SERVICE_URL=http://java-service:8080
# Origens permitidas do drone (CORS + handshake WebSocket). PRECISA incluir a
# origem do gateway/domínio real — senão o browser é barrado (403) antes do /ws.
# Em produção troque pelo domínio público (ex.: https://app.suaempresa.com).
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8088,http://nginx:80,http://localhost:8090

# --- E-mail (notificações do CRM — Fase 11.2 · recuperação de senha — D11) ---
# No BACKEND: sem MAIL_HOST o envio fica desabilitado (a task de lembretes vira no-op).
# Na IAM: MAIL_HOST é OBRIGATÓRIO fora de IAM_DEBUG — sem ele a recuperação de senha
# aceitaria a solicitação e nunca entregaria o token, travando o usuário em silêncio.
#
# Em dev/staging o compose aponta a IAM para o Mailpit (serviço `mailpit`, perfil
# `mail`), que CAPTURA todo e-mail e não entrega a ninguém: leia em http://localhost:8025.
# Antes do go-live, troque por um SMTP real (Resend/SES/etc.) e confirme SPF/DKIM.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Sistema de Gestão <noreply@sistemagestao.com>
# Timeout do socket SMTP (s). Sem ele, um SMTP pendurado segura o request da IAM.
MAIL_TIMEOUT=10
# Portas de host do Mailpit (parametrizáveis p/ o staging coexistir com o dev).
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# --- Recuperação de senha (D11) ---
# Base pública usada para montar o link do e-mail: é o domínio do GATEWAY (onde
# mora a tela do React), não o da IAM.
FRONTEND_BASE_URL=http://localhost:8090
# Vida do token de recuperação (min). Curto de propósito: enquanto vive, o token
# é uma credencial de takeover completo da conta.
PASSWORD_RESET_TTL_MINUTES=30
# Teto de solicitações por conta/IP por hora (anti-spam e anti-enumeração).
PASSWORD_RESET_MAX_POR_HORA=5
# Carência após troca de e-mail: durante ela, nenhum token de recuperação é emitido
# para a conta. Fecha o caminho "admin comprometido troca o e-mail da vítima e pede
# a recuperação para a própria caixa", dando tempo do aviso chegar ao endereço ANTIGO.
PASSWORD_RESET_COOLDOWN_TROCA_EMAIL_HORAS=24
# Validade do link de confirmação de troca de e-mail (enviado ao endereço ANTIGO).
EMAIL_CHANGE_TTL_HORAS=48

# --- Teto de requisições (S8) ---
# Até o S8 só o login tinha limite (no nginx): qualquer credencial válida podia
# varrer a API à vontade. Formato do DRF: "N/segundo|minuto|hora|dia".
# Folgado de propósito — é teto contra ABUSO, não controle de vazão. Apertar sem
# medir gera 429 no uso legítimo (uma tela do ERP dispara várias chamadas).
THROTTLE_ANON=120/min
# Teto da EMPRESA (D23) — o eixo que define um SaaS. Balde compartilhado por todos
# os usuários do tenant: sem ele, uma empresa de 50 funcionários consome 50× o que
# uma de 3 consome e degrada a experiência dela (noisy neighbor).
THROTTLE_TENANT=60000/hour
# Quanto da cota da empresa um único usuário pode consumir (0.05 = 5%). O teto de
# usuário DERIVA daqui — solto, ele mente nas duas pontas: 20 funcionários × 3000/h
# dariam 60.000/h à empresa sem ninguém ter declarado esse número.
THROTTLE_USER_FRACAO=0.05
# Escape hatch: definido, vence a derivação acima. Deixe comentado a menos que
# precise calibrar um caso específico sem mexer no teto da empresa.
# THROTTLE_USER=3000/hour
# Escopos nomeados, para views que declaram `throttle_scope`.
THROTTLE_RELATORIO=120/hour
THROTTLE_INTEGRACAO=300/hour
# IAM: teto do endpoint PÚBLICO de recuperação de senha, por origem. Complementa o
# teto por conta (PASSWORD_RESET_MAX_POR_HORA), que não cobre rajada contra contas
# diferentes (varredura de usernames / inundar caixas alheias).
THROTTLE_RECUPERACAO=30/hour
# Quantos proxies CONFIÁVEIS existem entre o cliente e a aplicação (hoje: só o
# gateway nginx = 1). Define de qual posição do X-Forwarded-For sai o IP real —
# usado pelo teto por IP E pelo IP gravado na trilha de segurança.
# CUIDADO: o gateway ACRESCENTA o IP real ao XFF que o cliente mandou. Com o
# número errado, volta a valer um endereço que o próprio cliente escolhe: o teto
# por IP fica contornável e a auditoria, poluível. Ao pôr CDN/ALB na frente
# (Cloudflare, etc.), aumente para a quantidade real de camadas.
NUM_PROXIES=1

# --- Observabilidade (Fase 10.1) ---
# LOG_FORMAT=json em qualquer ambiente compartilhado (é o que permite correlacionar
# por request_id/tenant_id); `console` só é legível para humano em dev local.
LOG_LEVEL=INFO
LOG_FORMAT=json
# Nome do serviço nos logs e nas métricas — distingue backend de IAM no Prometheus.
OBSERVABILITY_SERVICE_NAME=sgi-backend
# Diretório de métricas multiprocesso do Prometheus. Necessário com gunicorn
# (vários workers): sem ele, cada worker conta separado e o /metrics fica errado.
PROMETHEUS_MULTIPROC_DIR=
PROMETHEUS_PORT=9090

# --- Timeouts de integrações externas ---
# Todo timeout é (conectar, ler). Sem eles, um parceiro pendurado segura o worker
# indefinidamente — foi parte do achado L8.
NFE_IO_BASE_URL=https://api.nfe.io/v1
NFE_IO_CONNECT_TIMEOUT=5
# Leitura generosa: a emissão de NFS-e é assíncrona e pode demorar.
NFE_IO_READ_TIMEOUT=30
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# LLM de visão local (análise do diário de obra).
LLM_VISION_CONNECT_TIMEOUT=5
LLM_VISION_READ_TIMEOUT=120
# Chamadas serviço→serviço (backend→IAM, backend→drone).
SERVICE_CALL_CONNECT_TIMEOUT=3
SERVICE_CALL_READ_TIMEOUT=10
