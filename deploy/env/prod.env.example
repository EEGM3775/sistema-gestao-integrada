# ============================================================
# PRODUÇÃO — ESQUELETO NÃO VALIDADO
#
#   >>> Nenhum ambiente real subiu com este arquivo ainda. <<<
#
# Ele existe para deixar explícito o contraste com dev/staging e servir de
# CHECKLIST DE CUTOVER. O ambiente validado mais próximo de produção é o staging
# (deploy/env/staging.env.example + gate infra/staging/validate.sh 6/6).
#
# Só estão listadas aqui as variáveis cujo valor MUDA em relação ao dev, ou cuja
# ausência quebra produção. Tudo o mais: copie de dev.env.example, que documenta
# knob por knob.
#
# Regra de ouro: em produção nada tem default seguro por omissão. `DEBUG`/
# `IAM_DEBUG` são False, e nesse modo backend e IAM se RECUSAM a subir sem
# SECRET_KEY, ALLOWED_HOSTS e as chaves RS256 (achados S3/S4). Isso é proposital:
# é melhor não subir do que subir inseguro em silêncio.
# ============================================================

# --- 0. Imagens (Fase 10.5.3) -----------------------------------------------
# Publicadas pelo workflow `Imagens` a cada merge verde na main. TAG é a
# imutável `sha-<7 primeiros do commit>` (ou a versão `1.2.3` de uma tag v1.2.3);
# nunca `main`, que anda sozinha. Login: `docker login ghcr.io` com um token
# de leitura de pacotes.
REGISTRY=ghcr.io/eegm3775
TAG=

# --- 1. Modo produção -------------------------------------------------------
DEBUG=False
IAM_DEBUG=False
SECRET_KEY=                      # OBRIGATÓRIO — gere único, nunca reuse o de dev
IAM_SECRET_KEY=                  # OBRIGATÓRIO — distinto do SECRET_KEY
IAM_SEGUNDO_FATOR_CHAVE=         # OBRIGATÓRIO — chave Fernet; perdê-la obriga todos a recadastrar o segundo fator
ALLOWED_HOSTS=app.suaempresa.com
IAM_ALLOWED_HOSTS=app.suaempresa.com,iam,gateway

# --- 2. Assinatura do JWT (S3) ----------------------------------------------
# HS256 é PROIBIDO fora de DEBUG: quem valida também assinaria (tokens forjáveis).
# Gere o par com `bash infra/keys/generate.sh` e distribua só a PÚBLICA aos
# validadores (backend, drone). JWT_SECRET não é usado em produção.
JWT_PRIVATE_KEY_PATH=/keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/keys/jwt_public.pem
# Precisam bater entre IAM e backend, senão ninguém autentica (S8).
# Emissor e audiência saíram do env na fase 5 da remodelagem: a audiência é POR
# SERVIÇO (sgi-api, sgi-drone, sgi-iam) e mora em funcoesautorizacao/audiencias.py.
# Volta atrás da fase 5 (só em incidente, as duas juntas):
# BFF_ACCESS_NO_CORPO=False
# BFF_BEARER_DO_CLIENTE=False
# Capacidade (a IAM é consultada a cada chamada à API desde a fase 5):
# IAM_GUNICORN_WORKERS=2
# IAM_GUNICORN_THREADS=8
# ERP_GUNICORN_WORKERS=2
# ERP_GUNICORN_THREADS=4

# --- 3. Banco: gerenciado, com TLS (D14) ------------------------------------
# Postgres gerenciado (PITR + réplica), NÃO container do compose. `verify-full`
# é o modo que autentica o servidor e exige a CA — sem ela, falha na verificação.
DB_HOST=                         # endpoint do provedor
DB_PORT=5432
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/keys/db-ca.pem
DB_CONN_MAX_AGE=60
POSTGRES_DB=
POSTGRES_USER=                   # role de APLICAÇÃO: sem SUPERUSER, sem BYPASSRLS
POSTGRES_PASSWORD=               # (senão a RLS fail-closed deixa de valer)
IAM_POSTGRES_DB=
IAM_POSTGRES_USER=
IAM_POSTGRES_PASSWORD=

# --- 4. Redis gerenciado ----------------------------------------------------
# Com AUTH e TLS (rediss://). A persistência importa: o DB 2 guarda as épocas de
# revogação de sessão — perdê-las reabre sessões que foram revogadas.
REDIS_URL=rediss://:senha@host:6380/0
SESSION_REVOKE_REDIS_URL=rediss://:senha@host:6380/2
IAM_CACHE_REDIS_URL=rediss://:senha@host:6380/3
AUTORIZACAO_REDIS_URL=rediss://:senha@host:6380/5   # versões e cache de decisão do PDP
CELERY_TASK_ALWAYS_EAGER=False   # NUNCA True em produção

# --- 4b. PDP (SpiceDB) — acesso-e-permissoes.md §10.13 ----------------------
# Pelo menos duas réplicas sobre Postgres com réplica; sem isso a classe C para na
# primeira queda. A chave é o segredo que a IAM e o backend apresentam ao PDP.
SPICEDB_URL=https://spicedb.interno:8443
SPICEDB_CHAVE=                   # OBRIGATÓRIO — segredo longo e aleatório
SPICEDB_DB_PASSWORD=             # OBRIGATÓRIO
AUTORIZACAO_SOMBRA=True

# --- 5. Sessão e cookies ----------------------------------------------------
IAM_COOKIE_SECURE=1              # o cookie É a sessão; sem Secure trafega em claro (D16)
IAM_COOKIE_SAMESITE=Strict
SECURE_HSTS_SECONDS=31536000
SECURE_SSL_REDIRECT=False        # o TLS termina no gateway; ligar aqui causa loop
SESSION_REVOCATION_ENABLED=True  # False DESLIGA a revogação imediata inteira
SESSION_REVOCATION_FAIL_OPEN=True

# --- 6. E-mail: SMTP/ESP real ------------------------------------------------
# O Mailpit é andaime de dev e NÃO sobe em produção. MAIL_HOST é obrigatório com
# IAM_DEBUG=False: sem ele a recuperação de senha aceitaria a solicitação e nunca
# entregaria o token. Confirme SPF/DKIM/DMARC antes do go-live, senão o e-mail de
# recuperação cai em spam — o que, na prática, tranca os usuários para fora.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Sistema de Gestão <noreply@suaempresa.com>
MAIL_TIMEOUT=10
FRONTEND_BASE_URL=https://app.suaempresa.com

# --- 7. Integrações: credenciais de PRODUÇÃO ---------------------------------
# Atenção: sair do sandbox significa cobrança e nota fiscal REAIS.
ASAAS_BASE_URL=https://api.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=             # vazio = nenhum webhook aceito (fail-closed)
NFE_IO_BASE_URL=https://api.nfe.io/v1
NFE_IO_API_KEY=
NFE_IO_COMPANY_ID=
IA_SERVICE_SECRET_TOKEN=         # OBRIGATÓRIO fora de DEBUG (S7)
SERVICE_TOKEN_SECRET=            # OBRIGATÓRIO fora de DEBUG

# --- 8. Borda ---------------------------------------------------------------
# PRECISA ser o domínio público real: é a allowlist de CORS e do handshake do
# WebSocket do drone. Errado aqui = browser barrado com 403 antes do /ws.
APP_CORS_ALLOWED_ORIGINS=https://app.suaempresa.com
GATEWAY_PORT=80
GATEWAY_HTTPS_PORT=443

# --- 9. Observabilidade -----------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json                  # correlação por request_id/tenant_id depende disto
OBSERVABILITY_SERVICE_NAME=sgi-backend
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus

# --- 10. Tetos --------------------------------------------------------------
THROTTLE_ANON=120/min
THROTTLE_TENANT=60000/hour       # teto da EMPRESA (D23) — anti noisy neighbor
THROTTLE_USER_FRACAO=0.05        # teto do usuário DERIVA daqui (5% da empresa)
# THROTTLE_USER=3000/hour        # escape hatch: vence a derivação se definido
THROTTLE_RECUPERACAO=30/hour

# --- NÃO ir para produção ----------------------------------------------------
# WHATSAPP_DEFAULT_* — andaime single-tenant de dev; em produção as credenciais
#   Meta vivem por tenant no modelo funcoeswhatsapp.CanalWhatsApp.
# JWT_SECRET        — só existe no ramo HS256 (dev).
# MAILPIT_*         — o Mailpit não sobe aqui.
