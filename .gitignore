# --- Higiene do repo (nunca versionar aqui) ---
# Repo git aninhado separado (~2.4 GB, tem .git próprio): os fontes do ODM de
# terceiros e binários. O drone do SGI (Java + Angular + imagens) é versionado
# aqui, em funcoesODM/ (D225) — não voltar a editar a cópia do ImgDrone.
ImgDrone/
# Saídas de build do drone
funcoesODM/backend/java-service/target/
funcoesODM/frontend/.angular/
# Scratch de operação (scripts ad-hoc + logs de ngrok/webhook)
.runtime/
# Segredo OAuth do Google (funcoeslead) e afins
client_secret_*.json
# Lixo do Windows: device name reservado + alternate data streams de download
# (o WSL representa o ':' do ADS como U+F03A, então casa-se pelo sufixo, sem o ':')
nul
*Zone.Identifier
# Worktrees do Claude Code (análises descartáveis): nunca versionar
.claude/worktrees/

# Monitor do servidor: NADA dele vai para o GitHub (decisão do dono, 15/10/2026) —
# código, credenciais e testes ficam só na máquina e no servidor.
/monitor/
/testes/monitor/
