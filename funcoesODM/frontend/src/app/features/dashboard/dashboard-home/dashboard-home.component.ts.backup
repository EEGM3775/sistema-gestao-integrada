import { Component, OnInit, signal, computed, inject } from '@angular/core';
import { CommonModule } from '@angular/common';
import { RouterLink, Router } from '@angular/router';
import { AuthService } from '../../../core/services/auth.service';
import { ProjectService } from '../../projects/services/project.service';
import { Project } from '../../projects/models/project.model';

// Interface estendida para dados de UI
interface ProjectUI extends Project {
  progress: number;
  area: string;
  thumbnail: string;
  location: {
    lat: number;
    lng: number;
  };
}

@Component({
  selector: 'app-dashboard-home',
  standalone: true,
  imports: [CommonModule, RouterLink],
  template: `
    <div class="dashboard-container">
      <!-- Header Section -->
      <div class="page-header">
        <div class="header-left">
          <h1>Meus Projetos</h1>
          <p class="subtitle">{{ projects().length }} projetos • {{ getActiveCount() }} ativos</p>
        </div>
        <div class="header-actions">
          <div class="search-box">
            <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"/>
              <path d="m21 21-4.35-4.35"/>
            </svg>
            <input 
              type="text" 
              placeholder="Buscar projetos..." 
              [value]="searchTerm()"
              (input)="onSearch($event)"
              class="search-input"
            />
          </div>
          <div class="view-toggle">
            <button 
              class="toggle-btn" 
              [class.active]="viewMode() === 'grid'"
              (click)="setViewMode('grid')"
              title="Visualização em grade"
            >
              <svg viewBox="0 0 24 24" fill="currentColor">
                <rect x="3" y="3" width="7" height="7" rx="1"/>
                <rect x="14" y="3" width="7" height="7" rx="1"/>
                <rect x="3" y="14" width="7" height="7" rx="1"/>
                <rect x="14" y="14" width="7" height="7" rx="1"/>
              </svg>
            </button>
            <button 
              class="toggle-btn" 
              [class.active]="viewMode() === 'list'"
              (click)="setViewMode('list')"
              title="Visualização em lista"
            >
              <svg viewBox="0 0 24 24" fill="currentColor">
                <rect x="3" y="4" width="18" height="4" rx="1"/>
                <rect x="3" y="10" width="18" height="4" rx="1"/>
                <rect x="3" y="16" width="18" height="4" rx="1"/>
              </svg>
            </button>
          </div>
          <button class="btn-primary" routerLink="/projects/new">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 5v14M5 12h14"/>
            </svg>
            Novo Projeto
          </button>
        </div>
      </div>

      <!-- Stats Bar -->
      <div class="stats-bar">
        <div class="stat-item">
          <div class="stat-icon total">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
            </svg>
          </div>
          <div class="stat-content">
            <span class="stat-value">{{ stats().totalProjects }}</span>
            <span class="stat-label">Total de Projetos</span>
          </div>
        </div>
        <div class="stat-item">
          <div class="stat-icon processing">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
            </svg>
          </div>
          <div class="stat-content">
            <span class="stat-value">{{ stats().processing }}</span>
            <span class="stat-label">Processando</span>
          </div>
        </div>
        <div class="stat-item">
          <div class="stat-icon completed">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
          </div>
          <div class="stat-content">
            <span class="stat-value">{{ stats().completed }}</span>
            <span class="stat-label">Concluídos</span>
          </div>
        </div>
        <div class="stat-item">
          <div class="stat-icon images">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
              <circle cx="8.5" cy="8.5" r="1.5"/>
              <polyline points="21 15 16 10 5 21"/>
            </svg>
          </div>
          <div class="stat-content">
            <span class="stat-value">{{ stats().totalImages }}</span>
            <span class="stat-label">Imagens</span>
          </div>
        </div>
      </div>

      <!-- Loading State -->
      <div *ngIf="isLoading()" class="loading-state">
        <div class="spinner"></div>
        <p>Carregando projetos...</p>
      </div>

      <!-- Empty State -->
      <div *ngIf="!isLoading() && filteredProjects().length === 0" class="empty-state">
        <div class="empty-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
            <path d="M12 11v6M9 14h6"/>
          </svg>
        </div>
        <h3>Nenhum projeto encontrado</h3>
        <p>{{ searchTerm() ? 'Tente uma busca diferente' : 'Crie seu primeiro projeto de fotogrametria' }}</p>
        <button *ngIf="!searchTerm()" class="btn-primary" routerLink="/projects/new">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 5v14M5 12h14"/>
          </svg>
          Criar Projeto
        </button>
      </div>

      <!-- Grid View -->
      <div *ngIf="!isLoading() && filteredProjects().length > 0 && viewMode() === 'grid'" class="projects-grid">
        <div *ngFor="let project of filteredProjects()" class="project-card" [routerLink]="['/projects', project.id]">
          <!-- Card Thumbnail -->
          <div class="card-thumbnail">
            <img [src]="project.thumbnail" [alt]="project.name" loading="lazy" (error)="onImageError($event)" />
            <div class="card-overlay">
              <span class="image-count">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <polyline points="21 15 16 10 5 21"/>
                </svg>
                {{ project.imageCount }} imagens
              </span>
            </div>
            <div class="status-badge" [class]="project.status.toLowerCase()">
              {{ getStatusLabel(project.status) }}
            </div>
          </div>
          
          <!-- Card Content -->
          <div class="card-content">
            <h3 class="project-name">{{ project.name }}</h3>
            <p class="project-description">{{ project.description }}</p>
            
            <!-- Progress Bar for Processing -->
            <div *ngIf="project.status === 'PROCESSING'" class="progress-section">
              <div class="progress-info">
                <span>Processando...</span>
                <span>{{ project.progress }}%</span>
              </div>
              <div class="progress-bar">
                <div class="progress-fill" [style.width.%]="project.progress"></div>
              </div>
            </div>
            
            <!-- Card Meta -->
            <div class="card-meta">
              <span class="meta-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                  <line x1="16" y1="2" x2="16" y2="6"/>
                  <line x1="8" y1="2" x2="8" y2="6"/>
                  <line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
                {{ project.createdAt | date:'dd/MM/yy' }}
              </span>
              <span class="meta-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
                {{ project.area }}
              </span>
            </div>
          </div>
          
          <!-- Card Actions -->
          <div class="card-actions">
            <button class="action-btn" (click)="openMap($event, project)" title="Ver Mapa">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/>
                <line x1="8" y1="2" x2="8" y2="18"/>
                <line x1="16" y1="6" x2="16" y2="22"/>
              </svg>
            </button>
            <button class="action-btn" (click)="download($event, project)" title="Download">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
            </button>
            <button class="action-btn" (click)="openMenu($event, project)" title="Mais opções">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="1"/>
                <circle cx="19" cy="12" r="1"/>
                <circle cx="5" cy="12" r="1"/>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- List View -->
      <div *ngIf="!isLoading() && filteredProjects().length > 0 && viewMode() === 'list'" class="projects-list">
        <div class="list-header">
          <span class="col-name">Nome</span>
          <span class="col-status">Status</span>
          <span class="col-images">Imagens</span>
          <span class="col-area">Área</span>
          <span class="col-date">Data</span>
          <span class="col-actions">Ações</span>
        </div>
        <div *ngFor="let project of filteredProjects()" class="list-item" [routerLink]="['/projects', project.id]">
          <div class="col-name">
            <img [src]="project.thumbnail" [alt]="project.name" class="list-thumbnail" (error)="onImageError($event)" />
            <div class="project-info">
              <span class="project-name">{{ project.name }}</span>
              <span class="project-desc">{{ project.description }}</span>
            </div>
          </div>
          <div class="col-status">
            <span class="status-pill" [class]="project.status.toLowerCase()">
              {{ getStatusLabel(project.status) }}
            </span>
            <div *ngIf="project.status === 'PROCESSING'" class="mini-progress">
              <div class="mini-progress-fill" [style.width.%]="project.progress"></div>
            </div>
          </div>
          <div class="col-images">{{ project.imageCount }}</div>
          <div class="col-area">{{ project.area }}</div>
          <div class="col-date">{{ project.createdAt | date:'dd/MM/yyyy' }}</div>
          <div class="col-actions">
            <button class="icon-btn" (click)="openMap($event, project)" title="Ver Mapa">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/>
              </svg>
            </button>
            <button class="icon-btn" (click)="download($event, project)" title="Download">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
            </button>
            <button class="icon-btn" (click)="openMenu($event, project)" title="Mais">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="1"/>
                <circle cx="12" cy="5" r="1"/>
                <circle cx="12" cy="19" r="1"/>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  `,
  styles: [`
    .dashboard-container {
      padding: 2rem;
      max-width: 1600px;
      margin: 0 auto;
    }

    /* Header */
    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .page-header h1 {
      margin: 0;
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--color-text);
    }

    .subtitle {
      margin: 0.25rem 0 0;
      color: var(--color-text-muted);
      font-size: 0.875rem;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    /* Search Box */
    .search-box {
      position: relative;
      width: 280px;
    }

    .search-icon {
      position: absolute;
      left: 0.75rem;
      top: 50%;
      transform: translateY(-50%);
      width: 18px;
      height: 18px;
      color: var(--color-text-muted);
    }

    .search-input {
      width: 100%;
      padding: 0.625rem 1rem 0.625rem 2.5rem;
      border: 1px solid var(--color-border);
      border-radius: 8px;
      font-size: 0.875rem;
      transition: all 0.2s;
      background: var(--color-bg-white);
      color: var(--color-text);
    }

    .search-input:focus {
      outline: none;
      border-color: var(--color-primary);
      box-shadow: 0 0 0 3px var(--color-primary-bg);
    }

    /* View Toggle */
    .view-toggle {
      display: flex;
      border: 1px solid var(--color-border);
      border-radius: 8px;
      overflow: hidden;
    }

    .toggle-btn {
      padding: 0.5rem 0.75rem;
      background: var(--color-bg-white);
      border: none;
      cursor: pointer;
      color: var(--color-text-muted);
      transition: all 0.2s;
    }

    .toggle-btn:first-child {
      border-right: 1px solid var(--color-border);
    }

    .toggle-btn:hover {
      background: var(--color-bg-hover);
    }

    .toggle-btn.active {
      background: var(--color-primary);
      color: white;
    }

    .toggle-btn svg {
      width: 18px;
      height: 18px;
    }

    /* Primary Button */
    .btn-primary {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.625rem 1.25rem;
      background: var(--color-primary);
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 0.875rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s;
      text-decoration: none;
    }

    .btn-primary:hover {
      background: var(--color-primary-dark);
      transform: translateY(-1px);
      box-shadow: var(--shadow-md);
    }

    .btn-primary svg {
      width: 18px;
      height: 18px;
    }

    /* Stats Bar */
    .stats-bar {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin-bottom: 2rem;
    }

    .stat-item {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 1rem 1.25rem;
      background: var(--color-bg-white);
      border-radius: 12px;
      box-shadow: var(--shadow-sm);
      border: 1px solid var(--color-border);
    }

    .stat-icon {
      width: 48px;
      height: 48px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 12px;
    }

    .stat-icon svg {
      width: 24px;
      height: 24px;
    }

    .stat-icon.total {
      background: var(--color-primary-bg);
      color: var(--color-primary);
    }

    .stat-icon.processing {
      background: var(--color-warning-bg);
      color: var(--color-warning);
    }

    .stat-icon.completed {
      background: var(--color-success-bg);
      color: var(--color-success);
    }

    .stat-icon.images {
      background: var(--color-info-bg);
      color: var(--color-info);
    }

    .stat-content {
      display: flex;
      flex-direction: column;
    }

    .stat-value {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--color-text);
    }

    .stat-label {
      font-size: 0.8rem;
      color: var(--color-text-muted);
    }

    /* Loading State */
    .loading-state {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 4rem;
      color: var(--color-text-muted);
    }

    .spinner {
      width: 40px;
      height: 40px;
      border: 3px solid var(--color-border);
      border-top-color: var(--color-primary);
      border-radius: 50%;
      animation: spin 1s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    /* Empty State */
    .empty-state {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 4rem;
      text-align: center;
    }

    .empty-icon {
      width: 80px;
      height: 80px;
      background: var(--color-bg-hover);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1.5rem;
    }

    .empty-icon svg {
      width: 40px;
      height: 40px;
      color: var(--color-text-muted);
    }

    .empty-state h3 {
      margin: 0 0 0.5rem;
      color: var(--color-text);
      font-size: 1.25rem;
    }

    .empty-state p {
      margin: 0 0 1.5rem;
      color: var(--color-text-muted);
    }

    /* Projects Grid */
    .projects-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 1.5rem;
    }

    .project-card {
      background: var(--color-bg-white);
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid var(--color-border);
      cursor: pointer;
      transition: all 0.3s ease;
      display: flex;
      flex-direction: column;
    }

    .project-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-lg);
      border-color: var(--color-primary);
    }

    /* Card Thumbnail */
    .card-thumbnail {
      position: relative;
      height: 180px;
      overflow: hidden;
      background: linear-gradient(135deg, #1e40af 0%, #7c3aed 100%);
    }

    .card-thumbnail img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.3s ease;
    }

    .project-card:hover .card-thumbnail img {
      transform: scale(1.05);
    }

    .card-overlay {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 0.75rem;
      background: linear-gradient(transparent, rgba(0, 0, 0, 0.6));
    }

    .image-count {
      display: flex;
      align-items: center;
      gap: 0.375rem;
      color: white;
      font-size: 0.8rem;
    }

    .image-count svg {
      width: 14px;
      height: 14px;
    }

    .status-badge {
      position: absolute;
      top: 0.75rem;
      right: 0.75rem;
      padding: 0.375rem 0.75rem;
      border-radius: 20px;
      font-size: 0.7rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .status-badge.completed {
      background: var(--color-success);
      color: white;
    }

    .status-badge.processing {
      background: var(--color-warning);
      color: white;
      animation: pulse 2s infinite;
    }

    .status-badge.pending {
      background: var(--color-bg-active);
      color: white;
    }

    .status-badge.error {
      background: var(--color-danger);
      color: white;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.7; }
    }

    /* Card Content */
    .card-content {
      padding: 1rem;
      flex: 1;
    }

    .project-name {
      margin: 0 0 0.5rem;
      font-size: 1rem;
      font-weight: 600;
      color: var(--color-text);
      line-height: 1.3;
    }

    .project-description {
      margin: 0 0 0.75rem;
      font-size: 0.8rem;
      color: var(--color-text-secondary);
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    /* Progress Section */
    .progress-section {
      margin-bottom: 0.75rem;
    }

    .progress-info {
      display: flex;
      justify-content: space-between;
      font-size: 0.75rem;
      color: var(--color-text-muted);
      margin-bottom: 0.375rem;
    }

    .progress-bar {
      height: 4px;
      background: var(--color-border);
      border-radius: 2px;
      overflow: hidden;
    }

    .progress-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--color-warning), #fbbf24);
      border-radius: 2px;
      transition: width 0.3s ease;
    }

    /* Card Meta */
    .card-meta {
      display: flex;
      gap: 1rem;
      padding-top: 0.75rem;
      border-top: 1px solid var(--color-border);
    }

    .meta-item {
      display: flex;
      align-items: center;
      gap: 0.375rem;
      font-size: 0.75rem;
      color: var(--color-text-muted);
    }

    .meta-item svg {
      width: 14px;
      height: 14px;
    }

    /* Card Actions */
    .card-actions {
      display: flex;
      border-top: 1px solid var(--color-border);
      padding: 0.75rem;
      gap: 0.5rem;
    }

    .action-btn {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0.5rem;
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: 6px;
      cursor: pointer;
      color: var(--color-text-muted);
      transition: all 0.2s;
    }

    .action-btn:hover {
      background: var(--color-primary);
      border-color: var(--color-primary);
      color: white;
    }

    .action-btn svg {
      width: 18px;
      height: 18px;
    }

    /* List View */
    .projects-list {
      background: var(--color-bg-white);
      border-radius: 12px;
      border: 1px solid var(--color-border);
      overflow: hidden;
    }

    .list-header {
      display: grid;
      grid-template-columns: 2fr 1fr 0.75fr 0.75fr 1fr 0.75fr;
      padding: 0.875rem 1rem;
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--color-text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .list-item {
      display: grid;
      grid-template-columns: 2fr 1fr 0.75fr 0.75fr 1fr 0.75fr;
      padding: 0.875rem 1rem;
      border-bottom: 1px solid var(--color-border);
      align-items: center;
      cursor: pointer;
      transition: background 0.2s;
    }

    .list-item:last-child {
      border-bottom: none;
    }

    .list-item:hover {
      background: var(--color-bg-hover);
    }

    .col-name {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .list-thumbnail {
      width: 48px;
      height: 36px;
      object-fit: cover;
      border-radius: 4px;
    }

    .project-info {
      display: flex;
      flex-direction: column;
    }

    .project-info .project-name {
      font-size: 0.875rem;
      margin: 0;
    }

    .project-info .project-desc {
      font-size: 0.75rem;
      color: var(--color-text-muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 200px;
    }

    .col-status {
      display: flex;
      flex-direction: column;
      gap: 0.375rem;
    }

    .status-pill {
      display: inline-flex;
      padding: 0.25rem 0.625rem;
      border-radius: 20px;
      font-size: 0.7rem;
      font-weight: 500;
      width: fit-content;
    }

    .status-pill.completed {
      background: var(--color-success-bg);
      color: var(--color-success);
    }

    .status-pill.processing {
      background: var(--color-warning-bg);
      color: var(--color-warning);
    }

    .status-pill.pending {
      background: var(--color-bg-active);
      color: var(--color-text-secondary);
    }

    .status-pill.error {
      background: var(--color-danger-bg);
      color: var(--color-danger);
    }

    .mini-progress {
      width: 60px;
      height: 3px;
      background: var(--color-border);
      border-radius: 2px;
      overflow: hidden;
    }

    .mini-progress-fill {
      height: 100%;
      background: var(--color-warning);
      border-radius: 2px;
    }

    .col-images, .col-area, .col-date {
      font-size: 0.875rem;
      color: var(--color-text-secondary);
    }

    .col-actions {
      display: flex;
      gap: 0.375rem;
    }

    .icon-btn {
      width: 32px;
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      border: 1px solid transparent;
      border-radius: 6px;
      cursor: pointer;
      color: var(--color-text-muted);
      transition: all 0.2s;
    }

    .icon-btn:hover {
      background: var(--color-bg-hover);
      border-color: var(--color-border);
      color: var(--color-primary);
    }

    .icon-btn svg {
      width: 16px;
      height: 16px;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .dashboard-container {
        padding: 1rem;
      }

      .page-header {
        flex-direction: column;
        align-items: stretch;
      }

      .header-actions {
        flex-wrap: wrap;
      }

      .search-box {
        width: 100%;
        order: 1;
      }

      .projects-grid {
        grid-template-columns: 1fr;
      }

      .list-header,
      .list-item {
        grid-template-columns: 1fr auto auto;
      }

      .col-images, .col-area, .col-date {
        display: none;
      }
    }
  `]
})
export class DashboardHomeComponent implements OnInit {
  private projectService = inject(ProjectService);
  private router = inject(Router);
  
  isLoading = signal(true);
  searchTerm = signal('');
  viewMode = signal<'grid' | 'list'>('grid');
  projectsUI = signal<ProjectUI[]>([]);
  errorMessage = signal<string | null>(null);
  
  stats = computed(() => ({
    totalProjects: this.projectsUI().length,
    processing: this.projectsUI().filter((p: ProjectUI) => p.status === 'PROCESSING').length,
    completed: this.projectsUI().filter((p: ProjectUI) => p.status === 'COMPLETED').length,
    totalImages: this.projectsUI().reduce((sum: number, p: ProjectUI) => sum + p.imageCount, 0)
  }));

  filteredProjects = computed(() => {
    const term = this.searchTerm().toLowerCase();
    if (!term) return this.projectsUI();
    return this.projectsUI().filter((p: ProjectUI) => 
      p.name.toLowerCase().includes(term) ||
      (p.description?.toLowerCase().includes(term) ?? false)
    );
  });

  constructor(public authService: AuthService) {}

  ngOnInit(): void {
    this.loadProjects();
  }

  loadProjects(): void {
    this.isLoading.set(true);
    this.errorMessage.set(null);
    
    this.projectService.loadProjects().subscribe({
      next: (projects: Project[]) => {
        // Converte projetos da API para UI com dados extras
        const uiProjects: ProjectUI[] = projects.map((p: Project) => this.enrichProject(p));
        this.projectsUI.set(uiProjects);
        this.isLoading.set(false);
      },
      error: (err: Error) => {
        console.error('Erro ao carregar projetos:', err);
        this.errorMessage.set('Falha ao carregar projetos. Tente novamente.');
        this.isLoading.set(false);
        
        // Fallback para dados mock durante desenvolvimento
        this.loadMockProjects();
      }
    });
  }

  /**
   * Enriquece o projeto com dados de UI (thumbnail, área, etc)
   */
  private enrichProject(project: Project): ProjectUI {
    // Usa um placeholder SVG inline para evitar problemas com imagens externas
    const placeholder = 'data:image/svg+xml,' + encodeURIComponent(`
      <svg xmlns="http://www.w3.org/2000/svg" width="400" height="300" viewBox="0 0 400 300">
        <rect fill="#e2e8f0" width="400" height="300"/>
        <text x="200" y="150" text-anchor="middle" dy=".3em" fill="#94a3b8" font-family="system-ui" font-size="14">
          Projeto ${project.id}
        </text>
        <path d="M175 120h50v40h-50z" fill="none" stroke="#94a3b8" stroke-width="2"/>
        <circle cx="190" cy="135" r="5" fill="#94a3b8"/>
        <path d="M175 155l15-10 10 5 15-15 10 20" fill="none" stroke="#94a3b8" stroke-width="2"/>
      </svg>
    `.trim());
    
    return {
      ...project,
      progress: project.status === 'COMPLETED' ? 100 : project.status === 'PROCESSING' ? 50 : 0,
      area: 'Não definida',
      thumbnail: placeholder,
      location: { lat: -23.5505, lng: -46.6333 }
    };
  }

  /**
   * Carrega dados mock como fallback
   */
  private loadMockProjects(): void {
    const placeholder = this.getPlaceholderImage('Demo');
    
    const mockProjects: ProjectUI[] = [
      {
        id: 1,
        name: 'Fazenda São João - Mapeamento Aéreo',
        description: 'Levantamento topográfico completo para planejamento agrícola',
        status: 'COMPLETED',
        progress: 100,
        createdAt: '2025-01-15',
        updatedAt: '2025-01-16',
        imageCount: 245,
        taskCount: 3,
        area: '150 ha',
        thumbnail: placeholder,
        location: { lat: -23.5505, lng: -46.6333 },
        owner: 'Demo'
      },
      {
        id: 2,
        name: 'Obra Residencial Parque Verde',
        description: 'Acompanhamento de obra - Etapa fundação',
        status: 'PROCESSING',
        progress: 67,
        createdAt: '2025-01-18',
        updatedAt: '2025-01-20',
        imageCount: 128,
        taskCount: 2,
        area: '2.5 ha',
        thumbnail: placeholder,
        location: { lat: -23.5605, lng: -46.6433 },
        owner: 'Demo'
      },
      {
        id: 3,
        name: 'Inspeção Torre de Transmissão',
        description: 'Inspeção estrutural de linha de alta tensão',
        status: 'PENDING',
        progress: 0,
        createdAt: '2025-01-20',
        updatedAt: '2025-01-20',
        imageCount: 89,
        taskCount: 1,
        area: '0.5 ha',
        thumbnail: placeholder,
        location: { lat: -23.5405, lng: -46.6233 },
        owner: 'Demo'
      }
    ];

    this.projectsUI.set(mockProjects);
  }

  /**
   * Gera uma imagem placeholder SVG inline
   */
  private getPlaceholderImage(label: string): string {
    return 'data:image/svg+xml,' + encodeURIComponent(`
      <svg xmlns="http://www.w3.org/2000/svg" width="400" height="300" viewBox="0 0 400 300">
        <rect fill="#e2e8f0" width="400" height="300"/>
        <text x="200" y="150" text-anchor="middle" dy=".3em" fill="#94a3b8" font-family="system-ui" font-size="14">
          ${label}
        </text>
        <path d="M175 120h50v40h-50z" fill="none" stroke="#94a3b8" stroke-width="2"/>
        <circle cx="190" cy="135" r="5" fill="#94a3b8"/>
        <path d="M175 155l15-10 10 5 15-15 10 20" fill="none" stroke="#94a3b8" stroke-width="2"/>
      </svg>
    `.trim());
  }

  /**
   * Handler para erros de carregamento de imagem
   */
  onImageError(event: Event): void {
    const img = event.target as HTMLImageElement;
    img.src = this.getPlaceholderImage('Sem imagem');
  }

  projects = computed(() => this.projectsUI());

  getActiveCount(): number {
    return this.projectsUI().filter((p: ProjectUI) => 
      p.status === 'PROCESSING' || p.status === 'PENDING'
    ).length;
  }

  onSearch(event: Event): void {
    const input = event.target as HTMLInputElement;
    this.searchTerm.set(input.value);
  }

  setViewMode(mode: 'grid' | 'list'): void {
    this.viewMode.set(mode);
  }

  getStatusLabel(status: string): string {
    const labels: Record<string, string> = {
      'COMPLETED': 'Concluído',
      'PROCESSING': 'Processando',
      'PENDING': 'Pendente',
      'ERROR': 'Erro'
    };
    return labels[status] || status;
  }

  openMap(event: Event, project: ProjectUI): void {
    event.stopPropagation();
    this.router.navigate(['/projects', project.id]);
  }

  download(event: Event, project: ProjectUI): void {
    event.stopPropagation();
    // Navega para o projeto e abre a aba de downloads
    this.router.navigate(['/projects', project.id], { queryParams: { tab: 'downloads' } });
  }

  openMenu(event: Event, project: ProjectUI): void {
    event.stopPropagation();
    // Navega para os detalhes do projeto
    this.router.navigate(['/projects', project.id]);
  }
}
