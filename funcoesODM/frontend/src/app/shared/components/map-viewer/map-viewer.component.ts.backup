import { Component, Input, OnInit, OnDestroy, AfterViewInit, ElementRef, ViewChild, Output, EventEmitter, signal } from '@angular/core';
import { CommonModule } from '@angular/common';
import * as L from 'leaflet';

export interface MapLayer {
  id: string;
  name: string;
  type: 'orthomosaic' | 'dsm' | 'dtm' | 'ndvi' | 'markers' | 'measurements';
  url?: string;
  bounds?: L.LatLngBoundsExpression;
  visible: boolean;
  opacity: number;
  color?: string;
}

export interface MapMarker {
  id: string;
  lat: number;
  lng: number;
  label?: string;
  type?: 'gcp' | 'poi' | 'annotation';
  icon?: string;
}

export interface MeasurementResult {
  type: 'distance' | 'area' | 'volume';
  value: number;
  unit: string;
  coordinates: L.LatLng[];
}

@Component({
  selector: 'app-map-viewer',
  standalone: true,
  imports: [CommonModule],
  template: `
    <div class="map-container">
      <!-- Map Element -->
      <div #mapElement class="map-element"></div>
      
      <!-- Map Controls -->
      <div class="map-controls">
        <!-- Zoom Controls -->
        <div class="control-group zoom-controls">
          <button class="control-btn" (click)="zoomIn()" title="Zoom In">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"/>
              <path d="m21 21-4.35-4.35M8 11h6M11 8v6"/>
            </svg>
          </button>
          <button class="control-btn" (click)="zoomOut()" title="Zoom Out">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"/>
              <path d="m21 21-4.35-4.35M8 11h6"/>
            </svg>
          </button>
          <button class="control-btn" (click)="fitBounds()" title="Fit to Bounds">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/>
            </svg>
          </button>
        </div>

        <!-- View Controls -->
        <div class="control-group view-controls">
          <button 
            class="control-btn" 
            [class.active]="currentBasemap() === 'satellite'"
            (click)="setBasemap('satellite')" 
            title="Satélite"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
          </button>
          <button 
            class="control-btn" 
            [class.active]="currentBasemap() === 'street'"
            (click)="setBasemap('street')" 
            title="Mapa"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/>
              <line x1="8" y1="2" x2="8" y2="18"/>
              <line x1="16" y1="6" x2="16" y2="22"/>
            </svg>
          </button>
          <button 
            class="control-btn" 
            [class.active]="currentBasemap() === 'terrain'"
            (click)="setBasemap('terrain')" 
            title="Terreno"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m8 3 4 8 5-5 5 15H2L8 3z"/>
            </svg>
          </button>
        </div>

        <!-- Measurement Tools -->
        <div class="control-group tool-controls">
          <button 
            class="control-btn" 
            [class.active]="measureMode() === 'distance'"
            (click)="toggleMeasure('distance')" 
            title="Medir Distância"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.41 2.41 0 0 1 0-3.4l2.6-2.6a2.41 2.41 0 0 1 3.4 0Z"/>
              <path d="m14.5 12.5 2-2M11.5 9.5l2-2M8.5 6.5l2-2M17.5 15.5l2-2"/>
            </svg>
          </button>
          <button 
            class="control-btn" 
            [class.active]="measureMode() === 'area'"
            (click)="toggleMeasure('area')" 
            title="Medir Área"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2"/>
              <path d="M3 9h18M9 21V9"/>
            </svg>
          </button>
          <button 
            class="control-btn" 
            (click)="addMarker()" 
            title="Adicionar Marcador"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
          </button>
        </div>

        <!-- Fullscreen -->
        <div class="control-group">
          <button class="control-btn" (click)="toggleFullscreen()" title="Tela Cheia">
            <svg *ngIf="!isFullscreen()" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M8 3H5a2 2 0 0 0-2 2v3M21 8V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3M16 21h3a2 2 0 0 0 2-2v-3"/>
            </svg>
            <svg *ngIf="isFullscreen()" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M8 3v3a2 2 0 0 1-2 2H3M21 8h-3a2 2 0 0 1-2-2V3M3 16h3a2 2 0 0 1 2 2v3M16 21v-3a2 2 0 0 1 2-2h3"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Layers Panel -->
      <div class="layers-panel" [class.open]="showLayersPanel()">
        <button class="layers-toggle" (click)="toggleLayersPanel()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="12 2 2 7 12 12 22 7 12 2"/>
            <polyline points="2 17 12 22 22 17"/>
            <polyline points="2 12 12 17 22 12"/>
          </svg>
          <span>Camadas</span>
        </button>
        
        <div class="layers-content" *ngIf="showLayersPanel()">
          <h4>Camadas do Projeto</h4>
          <div class="layer-item" *ngFor="let layer of layers()">
            <label class="layer-checkbox">
              <input 
                type="checkbox" 
                [checked]="layer.visible" 
                (change)="toggleLayer(layer)"
              />
              <span class="checkmark"></span>
              <span class="layer-name">{{ layer.name }}</span>
            </label>
            <div class="layer-opacity" *ngIf="layer.visible">
              <input 
                type="range" 
                min="0" 
                max="100" 
                [value]="layer.opacity * 100"
                (input)="setLayerOpacity(layer, $event)"
              />
            </div>
          </div>
          
          <div class="layers-empty" *ngIf="layers().length === 0">
            <p>Nenhuma camada disponível</p>
          </div>
        </div>
      </div>

      <!-- Info Panel -->
      <div class="info-panel" *ngIf="selectedInfo()">
        <div class="info-header">
          <h4>{{ selectedInfo()?.title }}</h4>
          <button class="close-btn" (click)="clearSelection()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 6 6 18M6 6l12 12"/>
            </svg>
          </button>
        </div>
        <div class="info-content">
          <div *ngFor="let item of selectedInfo()?.items" class="info-item">
            <span class="info-label">{{ item.label }}</span>
            <span class="info-value">{{ item.value }}</span>
          </div>
        </div>
      </div>

      <!-- Measurement Result -->
      <div class="measurement-result" *ngIf="measurementResult()">
        <div class="result-header">
          <span class="result-type">{{ getMeasurementTypeLabel(measurementResult()!.type) }}</span>
          <button class="close-btn" (click)="clearMeasurement()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 6 6 18M6 6l12 12"/>
            </svg>
          </button>
        </div>
        <div class="result-value">
          {{ formatMeasurement(measurementResult()!) }}
        </div>
      </div>

      <!-- Coordinates Display -->
      <div class="coordinates-display">
        <span>{{ currentCoords().lat.toFixed(6) }}, {{ currentCoords().lng.toFixed(6) }}</span>
        <span class="zoom-level">Zoom: {{ currentZoom() }}</span>
      </div>

      <!-- Scale Bar -->
      <div class="scale-bar" #scaleBar></div>

      <!-- Loading Overlay -->
      <div class="loading-overlay" *ngIf="isLoading()">
        <div class="spinner"></div>
        <span>Carregando mapa...</span>
      </div>
    </div>
  `,
  styles: [`
    .map-container {
      position: relative;
      width: 100%;
      height: 100%;
      min-height: 400px;
      background: #1e293b;
      border-radius: 12px;
      overflow: hidden;
    }

    .map-element {
      width: 100%;
      height: 100%;
    }

    /* Map Controls */
    .map-controls {
      position: absolute;
      top: 1rem;
      right: 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      z-index: 1000;
    }

    .control-group {
      display: flex;
      flex-direction: column;
      background: white;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
      overflow: hidden;
    }

    .control-btn {
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: white;
      border: none;
      cursor: pointer;
      color: #475569;
      transition: all 0.2s;
    }

    .control-btn:hover {
      background: #f1f5f9;
      color: #3b82f6;
    }

    .control-btn.active {
      background: #3b82f6;
      color: white;
    }

    .control-btn:not(:last-child) {
      border-bottom: 1px solid #e2e8f0;
    }

    .control-btn svg {
      width: 18px;
      height: 18px;
    }

    /* Layers Panel */
    .layers-panel {
      position: absolute;
      top: 1rem;
      left: 1rem;
      z-index: 1000;
    }

    .layers-toggle {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1rem;
      background: white;
      border: none;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
      cursor: pointer;
      font-size: 0.875rem;
      font-weight: 500;
      color: #475569;
      transition: all 0.2s;
    }

    .layers-toggle:hover {
      background: #f8fafc;
    }

    .layers-toggle svg {
      width: 18px;
      height: 18px;
    }

    .layers-content {
      position: absolute;
      top: calc(100% + 0.5rem);
      left: 0;
      width: 280px;
      background: white;
      border-radius: 8px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
      padding: 1rem;
      animation: slideDown 0.2s ease;
    }

    @keyframes slideDown {
      from {
        opacity: 0;
        transform: translateY(-8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .layers-content h4 {
      margin: 0 0 0.75rem;
      font-size: 0.8rem;
      font-weight: 600;
      color: #64748b;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .layer-item {
      padding: 0.5rem 0;
      border-bottom: 1px solid #f1f5f9;
    }

    .layer-item:last-child {
      border-bottom: none;
    }

    .layer-checkbox {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      cursor: pointer;
      font-size: 0.875rem;
      color: #334155;
    }

    .layer-checkbox input {
      display: none;
    }

    .checkmark {
      width: 18px;
      height: 18px;
      border: 2px solid #cbd5e1;
      border-radius: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s;
    }

    .layer-checkbox input:checked + .checkmark {
      background: #3b82f6;
      border-color: #3b82f6;
    }

    .layer-checkbox input:checked + .checkmark::after {
      content: '';
      width: 6px;
      height: 10px;
      border: 2px solid white;
      border-top: none;
      border-left: none;
      transform: rotate(45deg);
      margin-bottom: 2px;
    }

    .layer-opacity {
      margin-top: 0.5rem;
      padding-left: 1.5rem;
    }

    .layer-opacity input[type="range"] {
      width: 100%;
      height: 4px;
      background: #e2e8f0;
      border-radius: 2px;
      appearance: none;
      cursor: pointer;
    }

    .layer-opacity input[type="range"]::-webkit-slider-thumb {
      appearance: none;
      width: 14px;
      height: 14px;
      background: #3b82f6;
      border-radius: 50%;
      cursor: pointer;
    }

    .layers-empty {
      text-align: center;
      padding: 1rem;
      color: #94a3b8;
      font-size: 0.875rem;
    }

    /* Info Panel */
    .info-panel {
      position: absolute;
      bottom: 3rem;
      left: 1rem;
      width: 280px;
      background: white;
      border-radius: 8px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
      overflow: hidden;
      z-index: 1000;
    }

    .info-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.75rem 1rem;
      background: #f8fafc;
      border-bottom: 1px solid #e2e8f0;
    }

    .info-header h4 {
      margin: 0;
      font-size: 0.9rem;
      font-weight: 600;
      color: #1e293b;
    }

    .close-btn {
      width: 24px;
      height: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      border: none;
      cursor: pointer;
      color: #64748b;
      border-radius: 4px;
    }

    .close-btn:hover {
      background: #e2e8f0;
      color: #1e293b;
    }

    .close-btn svg {
      width: 16px;
      height: 16px;
    }

    .info-content {
      padding: 0.75rem 1rem;
    }

    .info-item {
      display: flex;
      justify-content: space-between;
      padding: 0.375rem 0;
    }

    .info-label {
      font-size: 0.8rem;
      color: #64748b;
    }

    .info-value {
      font-size: 0.8rem;
      font-weight: 500;
      color: #1e293b;
    }

    /* Measurement Result */
    .measurement-result {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      background: white;
      border-radius: 12px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
      padding: 1.5rem;
      z-index: 1001;
      min-width: 200px;
      text-align: center;
    }

    .result-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.75rem;
    }

    .result-type {
      font-size: 0.8rem;
      font-weight: 600;
      color: #64748b;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .result-value {
      font-size: 1.75rem;
      font-weight: 700;
      color: #3b82f6;
    }

    /* Coordinates Display */
    .coordinates-display {
      position: absolute;
      bottom: 0.5rem;
      right: 0.5rem;
      display: flex;
      gap: 1rem;
      padding: 0.375rem 0.75rem;
      background: rgba(255, 255, 255, 0.95);
      border-radius: 4px;
      font-size: 0.75rem;
      font-family: 'Monaco', 'Consolas', monospace;
      color: #475569;
      z-index: 1000;
    }

    .zoom-level {
      color: #94a3b8;
    }

    /* Scale Bar */
    .scale-bar {
      position: absolute;
      bottom: 0.5rem;
      left: 50%;
      transform: translateX(-50%);
      z-index: 1000;
    }

    /* Loading Overlay */
    .loading-overlay {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: rgba(15, 23, 42, 0.9);
      z-index: 1002;
      color: white;
      gap: 1rem;
    }

    .spinner {
      width: 40px;
      height: 40px;
      border: 3px solid rgba(255, 255, 255, 0.2);
      border-top-color: #3b82f6;
      border-radius: 50%;
      animation: spin 1s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    /* Leaflet Overrides */
    :host ::ng-deep .leaflet-control-attribution {
      display: none;
    }

    :host ::ng-deep .leaflet-popup-content-wrapper {
      border-radius: 8px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
    }

    :host ::ng-deep .leaflet-popup-content {
      margin: 12px 16px;
      font-family: inherit;
    }
  `]
})
export class MapViewerComponent implements OnInit, AfterViewInit, OnDestroy {
  @ViewChild('mapElement') mapElement!: ElementRef;
  @ViewChild('scaleBar') scaleBar!: ElementRef;

  @Input() center: [number, number] = [-23.5505, -46.6333]; // São Paulo default
  @Input() zoom = 13;
  @Input() projectId?: number;

  @Output() markerAdded = new EventEmitter<MapMarker>();
  @Output() measurementComplete = new EventEmitter<MeasurementResult>();

  private map!: L.Map;
  private baseLayers: Record<string, L.TileLayer> = {};
  private overlayLayers: Map<string, L.Layer> = new Map();
  private measurePoints: L.LatLng[] = [];
  private measureLayer?: L.LayerGroup;

  isLoading = signal(true);
  isFullscreen = signal(false);
  showLayersPanel = signal(false);
  currentBasemap = signal<'satellite' | 'street' | 'terrain'>('satellite');
  measureMode = signal<'distance' | 'area' | null>(null);
  currentZoom = signal(13);
  currentCoords = signal({ lat: 0, lng: 0 });
  
  layers = signal<MapLayer[]>([
    { id: 'ortho', name: 'Ortomosaico', type: 'orthomosaic', visible: true, opacity: 1 },
    { id: 'dsm', name: 'Modelo Digital de Superfície', type: 'dsm', visible: false, opacity: 0.7 },
    { id: 'ndvi', name: 'Índice de Vegetação (NDVI)', type: 'ndvi', visible: false, opacity: 0.7 },
  ]);

  selectedInfo = signal<{ title: string; items: { label: string; value: string }[] } | null>(null);
  measurementResult = signal<MeasurementResult | null>(null);

  ngOnInit(): void {
    // Fix Leaflet default icon path issue
    delete (L.Icon.Default.prototype as any)._getIconUrl;
    L.Icon.Default.mergeOptions({
      iconRetinaUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-icon-2x.png',
      iconUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-icon.png',
      shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-shadow.png',
    });
  }

  ngAfterViewInit(): void {
    this.initializeMap();
  }

  ngOnDestroy(): void {
    if (this.map) {
      this.map.remove();
    }
  }

  private initializeMap(): void {
    // Create map
    this.map = L.map(this.mapElement.nativeElement, {
      center: this.center,
      zoom: this.zoom,
      zoomControl: false,
      attributionControl: false,
    });

    // Add base layers
    this.baseLayers['satellite'] = L.tileLayer(
      'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
      { maxZoom: 19 }
    );

    this.baseLayers['street'] = L.tileLayer(
      'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
      { maxZoom: 19 }
    );

    this.baseLayers['terrain'] = L.tileLayer(
      'https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png',
      { maxZoom: 17 }
    );

    // Add default basemap
    this.baseLayers['satellite'].addTo(this.map);

    // Add scale control
    L.control.scale({ position: 'bottomleft', imperial: false }).addTo(this.map);

    // Setup events
    this.map.on('mousemove', (e: L.LeafletMouseEvent) => {
      this.currentCoords.set({ lat: e.latlng.lat, lng: e.latlng.lng });
    });

    this.map.on('zoomend', () => {
      this.currentZoom.set(this.map.getZoom());
    });

    this.map.on('click', (e: L.LeafletMouseEvent) => {
      this.handleMapClick(e);
    });

    // Initialize current values
    this.currentZoom.set(this.map.getZoom());
    this.currentCoords.set({ lat: this.center[0], lng: this.center[1] });

    // Simulate loading
    setTimeout(() => {
      this.isLoading.set(false);
      this.addSampleData();
    }, 1000);
  }

  private addSampleData(): void {
    // Add sample markers (GCPs)
    const gcpIcon = L.divIcon({
      className: 'gcp-marker',
      html: `<div style="
        width: 24px; height: 24px; 
        background: #ef4444; 
        border: 3px solid white; 
        border-radius: 50%; 
        box-shadow: 0 2px 8px rgba(0,0,0,0.3);
        display: flex; align-items: center; justify-content: center;
        font-size: 10px; color: white; font-weight: bold;
      ">GCP</div>`,
      iconSize: [24, 24],
      iconAnchor: [12, 12],
    });

    const sampleGCPs = [
      { lat: this.center[0] + 0.002, lng: this.center[1] - 0.003, name: 'GCP-001' },
      { lat: this.center[0] - 0.001, lng: this.center[1] + 0.002, name: 'GCP-002' },
      { lat: this.center[0] + 0.003, lng: this.center[1] + 0.001, name: 'GCP-003' },
    ];

    sampleGCPs.forEach(gcp => {
      const marker = L.marker([gcp.lat, gcp.lng], { icon: gcpIcon })
        .addTo(this.map)
        .bindPopup(`<strong>${gcp.name}</strong><br>Lat: ${gcp.lat.toFixed(6)}<br>Lng: ${gcp.lng.toFixed(6)}`);
    });

    // Add sample polygon (project boundary)
    const projectBoundary = L.polygon([
      [this.center[0] + 0.005, this.center[1] - 0.005],
      [this.center[0] + 0.005, this.center[1] + 0.005],
      [this.center[0] - 0.005, this.center[1] + 0.005],
      [this.center[0] - 0.005, this.center[1] - 0.005],
    ], {
      color: '#3b82f6',
      weight: 2,
      fillColor: '#3b82f6',
      fillOpacity: 0.1,
      dashArray: '5, 10',
    }).addTo(this.map);

    projectBoundary.bindPopup('<strong>Área do Projeto</strong><br>150 ha');
  }

  private handleMapClick(e: L.LeafletMouseEvent): void {
    const mode = this.measureMode();
    if (!mode) return;

    this.measurePoints.push(e.latlng);

    if (!this.measureLayer) {
      this.measureLayer = L.layerGroup().addTo(this.map);
    }

    // Add point marker
    const pointMarker = L.circleMarker(e.latlng, {
      radius: 5,
      color: '#3b82f6',
      fillColor: '#3b82f6',
      fillOpacity: 1,
    });
    this.measureLayer.addLayer(pointMarker);

    if (mode === 'distance' && this.measurePoints.length >= 2) {
      // Draw line and calculate distance
      const polyline = L.polyline(this.measurePoints, {
        color: '#3b82f6',
        weight: 3,
      });
      this.measureLayer.addLayer(polyline);

      const distance = this.calculateDistance(this.measurePoints);
      this.measurementResult.set({
        type: 'distance',
        value: distance,
        unit: distance >= 1000 ? 'km' : 'm',
        coordinates: [...this.measurePoints],
      });
      this.measurementComplete.emit(this.measurementResult()!);
    } else if (mode === 'area' && this.measurePoints.length >= 3) {
      // Draw polygon and calculate area
      const polygon = L.polygon(this.measurePoints, {
        color: '#3b82f6',
        weight: 2,
        fillColor: '#3b82f6',
        fillOpacity: 0.2,
      });
      this.measureLayer.addLayer(polygon);

      const area = this.calculateArea(this.measurePoints);
      this.measurementResult.set({
        type: 'area',
        value: area,
        unit: area >= 10000 ? 'ha' : 'm²',
        coordinates: [...this.measurePoints],
      });
      this.measurementComplete.emit(this.measurementResult()!);
    }
  }

  private calculateDistance(points: L.LatLng[]): number {
    let total = 0;
    for (let i = 1; i < points.length; i++) {
      total += points[i - 1].distanceTo(points[i]);
    }
    return total;
  }

  private calculateArea(points: L.LatLng[]): number {
    // Shoelace formula for polygon area
    const R = 6371000; // Earth radius in meters
    let area = 0;
    const n = points.length;

    for (let i = 0; i < n; i++) {
      const j = (i + 1) % n;
      const lat1 = points[i].lat * Math.PI / 180;
      const lat2 = points[j].lat * Math.PI / 180;
      const lng1 = points[i].lng * Math.PI / 180;
      const lng2 = points[j].lng * Math.PI / 180;
      
      area += (lng2 - lng1) * (2 + Math.sin(lat1) + Math.sin(lat2));
    }

    return Math.abs(area * R * R / 2);
  }

  // Public methods
  zoomIn(): void {
    this.map.zoomIn();
  }

  zoomOut(): void {
    this.map.zoomOut();
  }

  fitBounds(): void {
    // Fit to project bounds or default view
    const bounds = L.latLngBounds([
      [this.center[0] - 0.01, this.center[1] - 0.01],
      [this.center[0] + 0.01, this.center[1] + 0.01],
    ]);
    this.map.fitBounds(bounds);
  }

  setBasemap(type: 'satellite' | 'street' | 'terrain'): void {
    // Remove current basemap
    Object.values(this.baseLayers).forEach(layer => {
      if (this.map.hasLayer(layer)) {
        this.map.removeLayer(layer);
      }
    });
    
    // Add new basemap
    this.baseLayers[type].addTo(this.map);
    this.currentBasemap.set(type);
  }

  toggleMeasure(type: 'distance' | 'area'): void {
    if (this.measureMode() === type) {
      this.clearMeasurement();
      this.measureMode.set(null);
    } else {
      this.clearMeasurement();
      this.measureMode.set(type);
    }
  }

  clearMeasurement(): void {
    this.measurePoints = [];
    if (this.measureLayer) {
      this.measureLayer.clearLayers();
    }
    this.measurementResult.set(null);
  }

  addMarker(): void {
    const center = this.map.getCenter();
    const marker: MapMarker = {
      id: `marker-${Date.now()}`,
      lat: center.lat,
      lng: center.lng,
      label: 'Novo Marcador',
      type: 'poi',
    };

    L.marker([marker.lat, marker.lng])
      .addTo(this.map)
      .bindPopup(`<strong>${marker.label}</strong><br>Lat: ${marker.lat.toFixed(6)}<br>Lng: ${marker.lng.toFixed(6)}`)
      .openPopup();

    this.markerAdded.emit(marker);
  }

  toggleFullscreen(): void {
    const container = this.mapElement.nativeElement.closest('.map-container');
    
    if (!this.isFullscreen()) {
      container.requestFullscreen?.() || 
      container.webkitRequestFullscreen?.() ||
      container.msRequestFullscreen?.();
      this.isFullscreen.set(true);
    } else {
      document.exitFullscreen?.() ||
      (document as any).webkitExitFullscreen?.() ||
      (document as any).msExitFullscreen?.();
      this.isFullscreen.set(false);
    }

    // Invalidate map size after fullscreen change
    setTimeout(() => this.map.invalidateSize(), 100);
  }

  toggleLayersPanel(): void {
    this.showLayersPanel.update(v => !v);
  }

  toggleLayer(layer: MapLayer): void {
    const updatedLayers = this.layers().map(l => 
      l.id === layer.id ? { ...l, visible: !l.visible } : l
    );
    this.layers.set(updatedLayers);
    
    // TODO: Actually toggle the layer on the map
    console.log('Toggle layer:', layer.id, !layer.visible);
  }

  setLayerOpacity(layer: MapLayer, event: Event): void {
    const input = event.target as HTMLInputElement;
    const opacity = parseInt(input.value) / 100;
    
    const updatedLayers = this.layers().map(l => 
      l.id === layer.id ? { ...l, opacity } : l
    );
    this.layers.set(updatedLayers);
    
    // TODO: Actually set the layer opacity
    console.log('Set layer opacity:', layer.id, opacity);
  }

  clearSelection(): void {
    this.selectedInfo.set(null);
  }

  getMeasurementTypeLabel(type: string): string {
    const labels: Record<string, string> = {
      'distance': 'Distância',
      'area': 'Área',
      'volume': 'Volume',
    };
    return labels[type] || type;
  }

  formatMeasurement(result: MeasurementResult): string {
    let value = result.value;
    let unit = result.unit;

    if (result.type === 'distance') {
      if (value >= 1000) {
        value = value / 1000;
        unit = 'km';
      }
      return `${value.toFixed(2)} ${unit}`;
    } else if (result.type === 'area') {
      if (value >= 10000) {
        value = value / 10000;
        unit = 'ha';
      }
      return `${value.toFixed(2)} ${unit}`;
    }
    return `${value.toFixed(2)} ${unit}`;
  }
}
