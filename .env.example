# ============================================================
# Variáveis de ambiente — Sistema de Gestão Integrada
# Copie para `.env` e ajuste. NUNCA versione o .env real.
# Ver docs/arquitetura.md (Fase 0) para o contexto de cada bloco.
# ============================================================

# --- Segredo JWT compartilhado (SSO) — SÓ DEV ---
# Usado apenas no modo de desenvolvimento (DEBUG=True), quando a assinatura cai
# para HS256. Em PRODUÇÃO (DEBUG=False) a assinatura HS256 é PROIBIDA (S3): defina
# as chaves RSA abaixo — a IAM assina com a privada e os validadores só conferem
# com a pública, sem poder forjar. Gere o par com `bash infra/keys/generate.sh`.
JWT_SECRET=troque-este-segredo-compartilhado-por-um-forte
# Caminhos das chaves RSA (RS256). Obrigatórios em produção; o compose já os aponta
# para /keys/*.pem nos containers. Localmente, aponte para infra/keys/ se for testar RS256.
# JWT_PRIVATE_KEY_PATH=infra/keys/jwt_private.pem   # só a IAM
# JWT_PUBLIC_KEY_PATH=infra/keys/jwt_public.pem     # IAM + ERP + drone

# --- PostgreSQL (cluster de dev via docker-compose) ---
# Superusuário de bootstrap usado só pelo container do Postgres.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer

# Banco e role da aplicação ERP (Django)
POSTGRES_DB=erp_db
POSTGRES_USER=erp_app
POSTGRES_PASSWORD=erp_app_senha_dev

# Banco e role da aplicação IAM
IAM_POSTGRES_DB=iam_db
IAM_POSTGRES_USER=iam_app
IAM_POSTGRES_PASSWORD=iam_app_senha_dev

# --- Redis (cache + Celery) ---
REDIS_URL=redis://localhost:6379/0

# --- Django (ERP) ---
# DEBUG default do código = False (produção). Mantenha True SÓ em dev. Em produção
# (DEBUG=False) SECRET_KEY e ALLOWED_HOSTS são OBRIGATÓRIOS: sem eles o serviço se
# recusa a subir (S4), em vez de usar segredos conhecidos e expor stack traces.
SECRET_KEY=troque-esta-secret-key-do-django
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- IAM ---
# Mesma regra: IAM_DEBUG default = False; em produção IAM_SECRET_KEY e
# IAM_ALLOWED_HOSTS são obrigatórios (fail-fast).
IAM_SECRET_KEY=troque-esta-secret-key-do-iam
IAM_DEBUG=True
IAM_ALLOWED_HOSTS=localhost,127.0.0.1,iam,gateway
# Tempo de vida dos tokens (minutos / dias)
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# --- funcoesODM (banco próprio, separado do cluster ERP/IAM) ---
ODM_POSTGRES_DB=funcoesodm
ODM_POSTGRES_USER=funcoesodm
ODM_POSTGRES_PASSWORD=funcoesodm_dev

# --- Gateway (Fase 4, compose unificado) ---
GATEWAY_PORT=8090

# --- E-mail (notificações do CRM — Fase 11.2) ---
# Sem MAIL_HOST, o envio fica desabilitado (a task de lembretes vira no-op).
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Sistema de Gestão <noreply@sistemagestao.com>
